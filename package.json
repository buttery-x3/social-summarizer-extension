{
  "name": "social-summarizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=24.15.0 <25" },
  "packageManager": "npm@11.12.1",
  "workspaces": ["packages/protocol", "apps/extension", "apps/helper"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:extension": "npm run build -w packages/protocol && npm run build -w apps/extension",
    "build:helper": "npm run build -w packages/protocol && npm run build -w apps/helper",
    "typecheck": "npm run build -w packages/protocol && npm run typecheck --workspaces && tsc -p tests/tsconfig.json",
    "test": "npm run build && npm run test:transport && npm run test:unit -w apps/helper",
    "test:transport": "node --test --experimental-strip-types tests/*.test.ts",
    "test:helper": "npm run build:helper && npm run test:unit -w apps/helper",
    "test:sdk": "npm run test:sdk -w apps/helper",
    "verify:vendor": "npm run verify:vendor -w apps/helper",
    "chatgpt": "npm run chatgpt -w apps/helper --",
    "test:chrome": "npm run build && node scripts/test-chrome.mjs",
    "test:integration": "npm run build && node scripts/test-chrome-summary.mjs",
    "test:integration:live": "npm run build && node scripts/test-chrome-summary.mjs --live",
    "test:registration": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tests/registration.test.ps1",
    "extension:id": "node scripts/extension-id.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.25.12",
    "playwright": "1.64.0",
    "typescript": "5.9.3"
  }
}
